# Enable router-tracked active decode blocks for the spillover policy.
# This is frontend-wide: the Rust proxy worker cannot advertise a per-model
# `router_config`, so the frontend process must enable tracking for every
# model it serves.
#
# Apply this to the frontend: export DYN_ROUTER_TRACK_ACTIVE_BLOCKS=true, or
# pass --router-track-active-blocks. If the frontend is started with an
# explicit --no-router-track-active-blocks, remove it: the CLI flag wins over
# this environment variable.
#
# Without tracking `dw-spillover` logs an error at policy construction and
# falls back to Dynamo's default policy for each model below, so failover
# never fires.
DYN_ROUTER_TRACK_ACTIVE_BLOCKS=true

# Models below use the dw-spillover policy and need active-block tracking:
#   - zai-org/GLM-5.3@interactive
#   - zai-org/GLM-5.3@throughput
