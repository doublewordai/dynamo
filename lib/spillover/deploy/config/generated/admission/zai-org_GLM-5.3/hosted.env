# Hosted workers for zai-org/GLM-5.3.
# lib/runtime/src/admission_gate.rs reads this from each worker process; the
# frontend does not read it. `export` so sourcing the file without `set -a`
# still reaches the worker process. Set it on every hosted worker.
export DYN_ADMISSION_QUEUE_MARGIN=256
