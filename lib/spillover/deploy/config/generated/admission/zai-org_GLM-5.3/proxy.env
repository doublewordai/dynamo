# Proxy workers for zai-org/GLM-5.3. They never report num_waiting_reqs, so the
# engine-queue margin is unenforceable on them. Clear it explicitly so a value
# cannot leak in from a shared launch environment.

unset DYN_ADMISSION_QUEUE_MARGIN
